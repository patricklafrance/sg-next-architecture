{
    "name": "@apps/protect-storybook",
    "description": "Storybook application for the SG Protect application.",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "postinstall": "pnpm msw init",
        "dev": "storybook dev -p 6006 --disable-telemetry",
        "build": "storybook build --disable-telemetry",
        "serve-build": "pnpm http-server storybook-static -p 8080 -P http://localhost:8080? -c-1",
        "eslint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
        "typecheck": "tsgo",
        "doctor": "storybook doctor"
    },
    "dependencies": {
        "@hopper-ui/components": "2.0.13",
        "@hopper-ui/styled-system": "3.1.6",
        "@storybook/addon-a11y": "10.2.16",
        "msw": "2.12.10",
        "msw-storybook-addon": "2.0.6",
        "react": "19.2.4",
        "react-aria": "3.47.0",
        "react-aria-components": "1.16.0",
        "react-dom": "19.2.4",
        "react-router": "7.13.1",
        "storybook": "10.2.16",
        "storybook-react-rsbuild": "3.3.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@rsbuild/core": "1.7.3",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/parser": "8.56.1",
        "@typescript/native-preview": "7.0.0-dev.20260309.1",
        "@workleap/eslint-configs": "1.1.14",
        "@workleap/rsbuild-configs": "3.2.3",
        "@workleap/typescript-configs": "3.0.7",
        "eslint": "9.39.2",
        "http-server": "14.1.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.53.1"
    },
    "msw": {
        "workerDirectory": [
            ".storybook/public"
        ]
    }
}

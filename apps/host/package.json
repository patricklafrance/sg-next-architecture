{
    "name": "@apps/host",
    "description": "ShareGate unified application.",
    "private": true,
    "author": "Workleap",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "postinstall": "pnpm msw init",
        "dev": "rsbuild dev --config rsbuild.dev.ts",
        "build": "pnpm run --sequential \"/^build:.*/\"",
        "build:app": "rsbuild build --config rsbuild.build.ts",
        "build:edge-functions": "rslib build --config rslib.edge-functions.ts",
        "serve-build": "pnpm http-server dist/app -p 8081 -P http://localhost:8081? -c-1 --cors",
        "eslint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
        "stylelint": "stylelint \"**/*.css\" --allow-empty-input --cache --cache-location node_modules/.cache/stylelint --max-warnings=0",
        "typecheck": "tsgo"
    },
    "dependencies": {
        "@hopper-ui/components": "2.0.13",
        "@hopper-ui/icons": "3.0.0",
        "@hopper-ui/styled-system": "3.1.6",
        "@modules/home-management": "workspace:*",
        "@modules/home-migration": "workspace:*",
        "@opentelemetry/api": "1.9.0",
        "@packages/core": "workspace:*",
        "@packages/core-module": "workspace:*",
        "@squide/firefly": "16.2.0",
        "@squide/firefly-rsbuild-storybook": "2.1.0",
        "@tanstack/react-query": "5.90.21",
        "@workleap/logging": "1.3.6",
        "@workleap/logrocket": "3.0.1",
        "@workleap/telemetry": "3.0.2",
        "launchdarkly-js-client-sdk": "3.9.0",
        "logrocket": "12.0.0",
        "react": "19.2.4",
        "react-aria": "3.47.0",
        "react-aria-components": "1.16.0",
        "react-dom": "19.2.4",
        "react-router": "7.13.1"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@rsbuild/core": "1.7.3",
        "@rslib/core": "0.19.6",
        "@rspack/core": "1.7.7",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/parser": "8.56.1",
        "@typescript/native-preview": "7.0.0-dev.20260309.1",
        "@workleap/browserslist-config": "2.1.7",
        "@workleap/eslint-configs": "1.1.14",
        "@workleap/netlify-skew-protection": "1.0.5",
        "@workleap/rsbuild-configs": "3.2.3",
        "@workleap/stylelint-configs": "2.1.8",
        "@workleap/typescript-configs": "3.0.7",
        "eslint": "9.39.2",
        "http-server": "14.1.1",
        "msw": "2.12.10",
        "prettier": "3.8.1",
        "storybook": "10.2.16",
        "storybook-react-rsbuild": "3.3.0",
        "stylelint": "17.4.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.53.1"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
